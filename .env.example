# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (public sitekey; Supabase Auth holds the secret key)
# Defaults when unset: production builds use 0x4AAAAAAGFnnXUAXbH46XCq,
# development uses Cloudflare's always-pass test key below.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Note: Replace these placeholder values with your actual configuration
