{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "great-wall-of-ideas",
  "compatibility_date": "2025-12-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": ".open-next/worker.js",
  // Served only on the custom domains (www redirects to the apex via a
  // Cloudflare redirect rule). No public *.workers.dev copy or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "greatwallofideas.com", "custom_domain": true },
    { "pattern": "www.greatwallofideas.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "great-wall-of-ideas"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
